{
  "name": "humanmap",
  "version": "1.1.0",
  "private": true,
  "description": "HumanMap - 人际关系·家族图谱",
  "scripts": {
    "validate:cpc": "node scripts/validate_cpc_import.js",
    "extract:structured": "node scripts/extract_structured_candidates.js",
