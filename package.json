    "verify:cppcc": "node scripts/verify_cppcc_profiles.js",
    "import:cppcc-leaders": "node scripts/import_cppcc_leaders.js",
    "discover:articles": "node scripts/discover_official_articles.js",
    "validate:articles": "node scripts/validate_official_articles.js",
    "register:sources": "node scripts/register_approved_sources.js",
    "discover:gov": "node scripts/discover_gov_organizations.js",
    "import:gov-org": "node scripts/import_gov_organizations.js",
    "sources:check": "node scripts/check_official_sources.js",
    "sources:validate-check": "node scripts/validate_official_check.js",
    "sources:validate": "node scripts/validate_official_sources.js",
    "import:cpc": "node scripts/import_cpc.js",
    "build:index": "node scripts/build_index.js",
    "build:db": "node scripts/build_db.js",
    "serve": "node scripts/serve_api.js",
    "serve:dev": "node -e \"process.env.HM_DEV='1';require('./scripts/serve_api.js').main()\"",
    "validate": "node scripts/validate_data.js",
    "check:refs": "node scripts/check_references.js",
    "admin": "node scripts/admin_server.js",
    "publish": "node scripts/export_static.js",
    "check:manifests": "node scripts/check_manifests.js",
    "raw:ingest:cbdb": "node tools/raw/ingest_cbdb.js",
    "raw:verify": "node tools/raw/verify_chain.js --heads",
    "raw:verify:full": "node tools/raw/verify_chain.js",
    "raw:heads": "node tools/raw/verify_chain.js --heads",
    "test": "node --test test/unit/*.test.js test/integration/*.test.js test/*.test.js",
    "test:unit": "node --test test/unit/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "hm": "node src/cli/hm.js",
    "cbdb:stats": "node src/cli/hm.js cbdb:stats",
    "cbdb:extract": "node src/cli/hm.js cbdb:extract",
    "graph:stats": "node src/cli/hm.js graph:stats",
    "graph:predicates": "node src/cli/hm.js graph:predicates",
    "graph:query": "node src/cli/hm.js graph:query",
    "timeline": "node src/cli/hm.js timeline",
    "check": "npm run raw:verify && npm run build:index && npm run validate && npm run check:refs && npm run check:manifests && npm run sources:validate && npm run sources:validate-check && npm run build:site && npm test",
    "import:cbdb": "node scripts/import_cbdb.js",
    "import-cbdb": "node scripts/import_cbdb.js",
    "import:spp": "node scripts/import_spp_leaders.js",
    "structure:spp": "node scripts/structure_spp_leaders.js",
    "merge:dupes": "node tools/oneoff/merge_duplicate_persons.js",
    "import:gov-leaders": "node scripts/import_gov_leaders.js",
    "structure:gov": "node scripts/structure_gov_leaders.js",
    "repair:gbk": "node tools/oneoff/repair_gbk_persons.js",
    "structure:cpc": "node scripts/structure_cpc_persons.js",
    "clean:summaries": "node tools/oneoff/clean_person_summaries.js",
    "build:site": "node scripts/build_site.js --clean",
    "build:static": "node scripts/build_static_pages.js"
